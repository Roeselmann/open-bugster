# Bootstrap identity for the very first start. It seeds the owner account, after which
# the user table is the only source of truth and these four values are ignored.
# APP_ADMIN_EMAIL is the sign-in name and the key everything is matched against; without
# it the address becomes <APP_USERNAME>@localhost.
APP_USERNAME=admin
APP_ADMIN_FIRST_NAME=
APP_ADMIN_LAST_NAME=
APP_ADMIN_EMAIL=
# Generate with: npm run password:hash -- "a-long-password"
APP_PASSWORD_HASH='scrypt$...'
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
# Set to true when Open-Bugster is only available over HTTPS.
NUXT_SESSION_COOKIE_SECURE=false

# Encrypts the App Store Connect keys stored per board.
# Generate with: openssl rand -base64 32
# If left empty, the key is derived from NUXT_SESSION_PASSWORD — changing that
# password then makes every stored .p8 unreadable.
BUGSTER_SECRET_KEY=

DATABASE_PATH=/data/open-bugster.sqlite
ATTACHMENTS_PATH=/data/attachments
