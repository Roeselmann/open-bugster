# Bootstrap identity for the very first start. It seeds the owner account, after which
# the user table is the only source of truth and these values are ignored.
# APP_ADMIN_EMAIL is the sign-in name and the key everything is matched against; without
# it the address becomes <APP_USERNAME>@localhost.
APP_USERNAME=admin
APP_ADMIN_FIRST_NAME=
APP_ADMIN_LAST_NAME=
APP_ADMIN_EMAIL=
# The owner's initial password, at least 12 characters. Read exactly once, to seed the
# owner on the first start; after that passwords live in the app and this line can go.
APP_ADMIN_PASSWORD=
# If the password should never touch this file, set a hash instead — it wins over
# APP_ADMIN_PASSWORD. Generate with: npm run password:hash -- "a-long-password"
#APP_PASSWORD_HASH='scrypt$...'

# The two machine secrets are optional: whatever is left empty is generated on the first
# start and kept in secrets.json next to the database, inside the data volume. Set them
# here only to manage them yourself (generate with: openssl rand -base64 32).
# NUXT_SESSION_PASSWORD signs the login cookie.
NUXT_SESSION_PASSWORD=
# BUGSTER_SECRET_KEY encrypts the App Store Connect keys stored per board. Legacy note:
# when NUXT_SESSION_PASSWORD is set and this is not, the key is derived from the session
# password — changing that password then makes every stored .p8 unreadable.
BUGSTER_SECRET_KEY=

# Set to true when Open-Bugster is only available over HTTPS.
NUXT_SESSION_COOKIE_SECURE=false

DATABASE_PATH=/data/open-bugster.sqlite
ATTACHMENTS_PATH=/data/attachments

# How long the audit log keeps an entry, in days. Swept once at startup.
# Set to 0 to keep everything, if your own rules say the log may never be pruned.
AUDIT_RETENTION_DAYS=365

# Webhooks deliver to private addresses by default, because an n8n or a CI runner is usually
# on the same Docker network. Set to false to allow public addresses only.
# The cloud metadata range (169.254.0.0/16) is refused either way.
WEBHOOK_ALLOW_PRIVATE=true
